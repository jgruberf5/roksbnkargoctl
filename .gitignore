/bin/
/check
/roksbnkargoctl
/dist/
*.test
*.out
# Workspaces and anything that could hold a key never belong in this repo.
.roksbnkargoctl/
*.tgz
*.jwt
# Anchored: an unanchored "kubeconfig*" also ignored internal/ibm/kubeconfig.go,
# which CI then could not build.
/kubeconfig*
*.kubeconfig
# Local environment files hold credentials (API keys, FAR key, JWTs).
.env
.env.*
!.env.example
