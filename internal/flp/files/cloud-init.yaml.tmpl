#cloud-config
# F5 License Proxy on a stock Ubuntu VSI (podman pod, no Kubernetes), rendered by
# roksbnkargoctl `flp up`. The CA is generated by roksbnkargoctl and injected here;
# the box signs its own mTLS leaves from it and brings up the pod.
package_update: true
packages: [podman, openssl, jq, curl]

write_files:
  - path: /opt/flp/answer.env
    permissions: '0600'
    content: |
      JWT_TOKEN={{.JWT}}
      EXTERNAL_IP={{.ExternalIP}}
      FAR_HOST={{.FARHost}}
      REG={{.Registry}}
      TAG={{.Tag}}
      VAULT_TAG={{.VaultTag}}
      F5_CERT_URL={{.CertURL}}
      F5_ENTITLEMENT_URL={{.EntitlementURL}}
      F5_INITIAL_CONFIG_URL={{.InitialConfigURL}}
      MODE_OF_OPERATION=connected
      IS_PROXY_ENABLED=false
  - path: /opt/flp/cne_pull_64.json
    permissions: '0600'
    content: |
      {{.FARServiceAccount}}
  - path: /opt/flp/prod_jwks.txt
    permissions: '0644'
    encoding: b64
    content: {{.ProdJWKSB64}}
  - path: /opt/flp/ca.crt
    permissions: '0644'
    encoding: b64
    content: {{.CACertB64}}
  - path: /opt/flp/ca.key
    permissions: '0600'
    encoding: b64
    content: {{.CAKeyB64}}
  - path: /opt/flp/flp-pod-up.sh
    permissions: '0755'
    encoding: b64
    content: {{.PodUpB64}}
  - path: /etc/systemd/system/flp.service
    permissions: '0644'
    content: |
      [Unit]
      Description=F5 License Proxy (podman pod) - first-boot bring-up
      After=network-online.target
      Wants=network-online.target
      ConditionPathExists=!/opt/flp/.provisioned
      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/opt/flp/flp-pod-up.sh
      [Install]
      WantedBy=multi-user.target
  - path: /opt/flp/flp-health.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      # Gentle self-heal: acts only after the proxy has served once, and only ever
      # restarts the systemd-managed pod (never re-stages), so it cannot loop.
      if curl -sk --max-time 8 https://localhost:8443/ -o /dev/null 2>/dev/null; then
        touch /opt/flp/.served
        exit 0
      fi
      [ -f /opt/flp/.served ] || exit 0
      systemctl restart pod-flp.service 2>/dev/null || true
      exit 0
  - path: /etc/systemd/system/flp-health.service
    permissions: '0644'
    content: |
      [Unit]
      Description=F5 License Proxy health self-heal
      After=network-online.target
      Wants=network-online.target
      [Service]
      Type=oneshot
      ExecStart=/opt/flp/flp-health.sh
  - path: /etc/systemd/system/flp-health.timer
    permissions: '0644'
    content: |
      [Unit]
      Description=Periodic F5 License Proxy health check
      [Timer]
      OnBootSec=300s
      OnUnitActiveSec=120s
      [Install]
      WantedBy=timers.target

runcmd:
  - [ systemctl, enable, --now, flp.service ]
  - [ systemctl, enable, --now, flp-health.timer ]

final_message: "F5 License Proxy VSI provisioned (podman pod on 8443)."
